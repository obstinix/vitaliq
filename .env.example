# Copy to .env and fill in local values. Never commit .env.

APP_NAME=Vitaliq
# local | testing | production
APP_ENV=local
# true shows exception messages on error pages (local only)
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
# 64 hex characters. Generate with: php bin/generate-key.php
APP_KEY=
APP_TIMEZONE=Asia/Kolkata

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vitaliq
DB_USER=vitaliq
DB_PASS=

# Used by PHPUnit. Must end in _test; the suite drops and recreates its tables.
TEST_DB_NAME=vitaliq_test

SESSION_NAME=vitaliq_session
SESSION_IDLE_MINUTES=30
# auto (secure when the request is HTTPS) | true | false
SESSION_SECURE_COOKIE=auto

# outbox: write messages as .eml files to storage/mail (local development only)
# none:   do not deliver messages at all
MAIL_DRIVER=outbox
MAIL_FROM=no-reply@vitaliq.example

# Notification bell polling interval in seconds (polling, not push)
NOTIFICATION_POLL_SECONDS=30

# Teleconsultation rooms (Jitsi Meet or a self-hosted Jitsi server).
# Room names are random and unguessable; no account is needed on meet.jit.si.
TELECONSULT_BASE_URL=https://meet.jit.si
