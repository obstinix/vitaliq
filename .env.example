# Copy to .env and fill in local values. Never commit .env.

APP_NAME=Vitaliq
# local | testing | production
APP_ENV=local
# true shows exception messages on error pages (local only)
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
# 64 hex characters. Generate with: php bin/generate-key.php
APP_KEY=
APP_TIMEZONE=Asia/Kolkata

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vitaliq
DB_USER=vitaliq
DB_PASS=

# Used by PHPUnit. Must end in _test; the suite drops and recreates its tables.
TEST_DB_NAME=vitaliq_test

SESSION_NAME=vitaliq_session
SESSION_IDLE_MINUTES=30
# auto (secure when the request is HTTPS) | true | false
SESSION_SECURE_COOKIE=auto

# Email (feature 31)
# outbox: write messages as .eml files to storage/mail (local development only)
# smtp:   deliver through an SMTP server (credentials below)
# none:   do not deliver messages at all
MAIL_DRIVER=outbox
MAIL_FROM=no-reply@vitaliq.example
MAIL_HOST=
MAIL_PORT=587
# tls (STARTTLS) | ssl (implicit TLS, usually port 465)
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# SMS and WhatsApp (features 32, 33): none | log (local file, nothing sent) | twilio
SMS_DRIVER=none
SMS_FROM=
WHATSAPP_DRIVER=none
# A WhatsApp-enabled Twilio sender, e.g. +14155238886 (sandbox) or your approved number
WHATSAPP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Notification bell polling interval in seconds (polling, not push)
NOTIFICATION_POLL_SECONDS=30

# Health information assistant (feature 51): none | anthropic
# With "anthropic", AI_API_KEY is an Anthropic API key. Leave "none" to keep
# the assistant switched off; the page then says so instead of answering.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5-5

# Teleconsultation rooms (Jitsi Meet or a self-hosted Jitsi server).
# Room names are random and unguessable; no account is needed on meet.jit.si.
TELECONSULT_BASE_URL=https://meet.jit.si
